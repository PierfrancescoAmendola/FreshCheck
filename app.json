{
  "expo": {
    "name": "FreshCheck",
    "slug": "freshcheck",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.freshcheck",
      "infoPlist": {
        "NSCameraUsageDescription": "FreshCheck uses the camera to scan barcodes and read expiry dates. Photos are processed on your device and never saved.",
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "3",
      "appleTeamId": "9JFPPZ56V8",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F6FB"
      },
      "package": "com.anonymous.freshcheck",
      "permissions": [
        "CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10B26C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FreshCheck uses the camera to scan barcodes and read expiry dates. Photos are processed on your device and never saved.",
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#10B26C"
    },
    "locales": {
      "en": "./locales/en.json",
      "it": "./locales/it.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt": "./locales/pt.json",
      "nl": "./locales/nl.json",
      "pl": "./locales/pl.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json"
    }
  }
}